option domain-name "{{ centos_dhcpd_domain_name }}";
option domain-name-servers {{ centos_dhcpd_domain_dns_servers | join(', ') }};
default-lease-time {{ centos_dhcpd_default_lease_time }};
max-lease-time {{ centos_dhcpd_max_lease_time }};
{%- if centos_dhcpd_authoritative %}
authoritative;
{%- endif %}
log-facility {{ centos_dhcpd_log_facility }};
one-lease-per-client true;
allow booting;
allow bootp;

subnet {{ centos_dhcpd_subnet_ip_address }} netmask {{ centos_dhcpd_netmask_ip_address }} {
  range dynamic-bootp {{ centos_dhcpd_dynamic_ip_range[0] }} {{ centos_dhcpd_dynamic_ip_range[1] }};
  option routers {{ centos_dhcpd_gateway_ip_address }};
  option broadcast-address {{ centos_dhcpd_broadcast_ip_address }};
  default-lease-time {{ centos_dhcpd_default_lease_time }};
  max-lease-time {{ centos_dhcpd_max_lease_time }};
  filename "{{ centos_dhcpd_pxelinux_filename }}";
  next-server {{ centos_dhcpd_next_server | default(ansible_facts['default_ipv4']['address'], true) }};

# Serve clients by a MAC address prefix.
# A partial MAC address matches one vendor.
# Example: 08:00:27 matches VirtualBox.
{% for pool in centos_dhcpd_pools %}
{%- if pool.match_by == 'mac' %}
  class "{{ pool.name }}" {
    match if substring (hardware,1,{{ pool.match_value.split(':') | length }}) = "{{ pool.match_value }}";
  }
{%- else %}
# Serve clients whose hostname starts with this string.
  class "{{ pool.name }}" {
    match if substring (option host-name,0,{{ pool.match_value | length }}) = "{{ pool.match_value }}";
  }
{%- endif %}
{% endfor %}
# One IP pool per class above.
{% for pool in centos_dhcpd_pools %}
  pool {
    range dynamic-bootp {{ pool.range[0] }} {{ pool.range[1] }};
    allow members of "{{ pool.name }}";
    filename "{{ centos_dhcpd_pxelinux_filename }}";
    next-server {{ pool.next_server | default(centos_dhcpd_next_server, true) | default(ansible_facts['default_ipv4']['address'], true) }};
  }
{% endfor %}
}
