      { "name": "{{ pool.name }}",
        "test": "option[12].exists and substring(option[12].hex, 0, {{ pool.match_value | length }}) == '{{ pool.match_value }}'" }{{ "," if not loop.last }}
{% endif %}
{% endfor %}
    ],
    "subnet4": [
      {
        "id": 100,
        "subnet": "{{ centos_dhcpd_subnet_ip_address }}/{{ centos_dhcpd_netmask_ip_address.split('.') | map('int') | map('extract', __bits) | sum }}",
        "valid-lifetime": {{ centos_dhcpd_default_lease_time }},
        "max-valid-lifetime": {{ centos_dhcpd_max_lease_time }},
        "pools": [
          { "pool": "{{ centos_dhcpd_dynamic_ip_range[0] }} - {{ centos_dhcpd_dynamic_ip_range[1] }}" }
{% for pool in centos_dhcpd_pools %}
          , { "pool": "{{ pool.range[0] }} - {{ pool.range[1] }}", "client-classes": ["{{ pool.name }}"]{% if pool.next_server %}, "next-server": "{{ pool.next_server }}"{% endif %} }
{% endfor %}
        ],
        "option-data": [
          { "name": "routers", "data": "{{ centos_dhcpd_gateway_ip_address }}" },
          { "name": "broadcast-address", "data": "{{ centos_dhcpd_broadcast_ip_address }}" },
          { "name": "domain-name", "data": "{{ centos_dhcpd_domain_name }}" },
          { "name": "domain-name-servers", "data": "{{ centos_dhcpd_domain_dns_servers | join(', ') }}" }
        ]
      }
    ]
